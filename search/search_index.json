{"config":{"lang":["ja"],"separator":"[\\s\\-\u3000\u3001\u3002\uff0c\uff0e]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"faq/","title":"\u3088\u304f\u3042\u308b\u8cea\u554f (FAQ)","text":""},{"location":"faq/#_1","title":"\u30dd\u30a4\u30f3\u30c8\u306b\u3064\u3044\u3066","text":""},{"location":"faq/#q","title":"Q. \u30dd\u30a4\u30f3\u30c8\u306f\u3044\u3064\u8ffd\u52a0\u3055\u308c\u307e\u3059\u304b\uff1f","text":"<p>A. \u6bce\u67081\u65e5\u306b\u3001\u7121\u6599\u30dd\u30a4\u30f3\u30c8\u304c\u4ed8\u4e0e\u3055\u308c\u307e\u3059\u3002</p>"},{"location":"faq/#q_1","title":"Q. \u30dd\u30a4\u30f3\u30c8\u304c\u306a\u304f\u306a\u3063\u305f\u3089\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3059\u304b\uff1f","text":"<p>A. \u73fe\u5728\u3001\u30dd\u30a4\u30f3\u30c8\u306e\u8ffd\u52a0\u8cfc\u5165\u6a5f\u80fd\u306f\u6e96\u5099\u4e2d\u3067\u3059\u3002\u7fcc\u6708\u306e\u4ed8\u4e0e\u3092\u304a\u5f85\u3061\u304f\u3060\u3055\u3044\u3002</p>"},{"location":"faq/#q_2","title":"Q. \u3069\u306e\u30e2\u30c7\u30eb\u3092\u4f7f\u3048\u3070\u3044\u3044\u3067\u3059\u304b\uff1f","text":"<p>A. \u8ff7\u3063\u305f\u3089 GPT-4o mini (2pt) \u304c\u304a\u3059\u3059\u3081\u3067\u3059\u3002\u6d88\u8cbb\u30dd\u30a4\u30f3\u30c8\u304c\u5c11\u306a\u304f\u3001\u5341\u5206\u306a\u54c1\u8cea\u306e\u8a18\u4e8b\u304c\u66f8\u3051\u307e\u3059\u3002\u3088\u308a\u611f\u52d5\u7684\u306a\u6587\u7ae0\u3092\u66f8\u304d\u305f\u3044\u3068\u304d\u306f Claude 3.5 Sonnet \u3092\u8a66\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002</p>"},{"location":"faq/#_2","title":"\u8a18\u4e8b\u4f5c\u6210\u306b\u3064\u3044\u3066","text":""},{"location":"faq/#q_3","title":"Q. \u4f5c\u6210\u3055\u308c\u305f\u8a18\u4e8b\u3092\u305d\u306e\u307e\u307e\u6295\u7a3f\u3057\u3066\u3082\u5927\u4e08\u592b\u3067\u3059\u304b\uff1f","text":"<p>A. AI\u306f\u975e\u5e38\u306b\u9ad8\u3044\u7cbe\u5ea6\u3067\u6587\u7ae0\u3092\u4f5c\u6210\u3057\u307e\u3059\u304c\u3001\u5fc5\u305a\u5185\u5bb9\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u7279\u306b\u65e5\u4ed8\u3001\u4fa1\u683c\u3001\u30e1\u30cb\u30e5\u30fc\u540d\u306a\u3069\u306f\u9593\u9055\u3044\u304c\u542b\u307e\u308c\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002</p>"},{"location":"faq/#q_4","title":"Q. \u5199\u771f\u3082\u81ea\u52d5\u3067\u4f5c\u3063\u3066\u304f\u308c\u307e\u3059\u304b\uff1f","text":"<p>A. \u73fe\u5728\u306f\u6587\u7ae0\u306e\u4f5c\u6210\u306e\u307f\u306b\u5bfe\u5fdc\u3057\u3066\u3044\u307e\u3059\u3002\u5199\u771f\u306f\u3054\u81ea\u8eab\u3067\u64ae\u5f71\u3057\u305f\u3082\u306e\u3092\u3054\u5229\u7528\u304f\u3060\u3055\u3044\u3002</p>"},{"location":"faq/#q_5","title":"Q. \u30b9\u30de\u30db\u3067\u3082\u4f7f\u3048\u307e\u3059\u304b\uff1f","text":"<p>A. \u306f\u3044\u3001\u30d6\u30e9\u30a6\u30b6\u304b\u3089\u30a2\u30af\u30bb\u30b9\u3059\u308c\u3070\u30b9\u30de\u30fc\u30c8\u30d5\u30a9\u30f3\u3067\u3082\u3054\u5229\u7528\u3044\u305f\u3060\u3051\u307e\u3059\u3002</p>"},{"location":"getting-started/","title":"\u30b9\u30bf\u30fc\u30c8\u30ac\u30a4\u30c9","text":""},{"location":"getting-started/#1","title":"1. \u30a2\u30ab\u30a6\u30f3\u30c8\u4f5c\u6210\u3068\u30ed\u30b0\u30a4\u30f3","text":"<p>\u307e\u305a\u306f\u3058\u3081\u306b\u3001\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u4f5c\u6210\u3057\u307e\u3057\u3087\u3046\u3002</p> <ol> <li>\u767b\u9332\u753b\u9762\u3078\u30a2\u30af\u30bb\u30b9: \u30c8\u30c3\u30d7\u30da\u30fc\u30b8\u306e\u300c\u65b0\u898f\u767b\u9332\u300d\u30dc\u30bf\u30f3\u3092\u30af\u30ea\u30c3\u30af\u3057\u307e\u3059\u3002</li> <li>\u60c5\u5831\u306e\u5165\u529b: \u30e1\u30fc\u30eb\u30a2\u30c9\u30ec\u30b9\u3068\u30d1\u30b9\u30ef\u30fc\u30c9\u3092\u5165\u529b\u3057\u307e\u3059\u3002</li> <li>\u78ba\u8a8d\u30e1\u30fc\u30eb: \u767b\u9332\u3057\u305f\u30e1\u30fc\u30eb\u30a2\u30c9\u30ec\u30b9\u306b\u78ba\u8a8d\u30b3\u30fc\u30c9\u304c\u5c4a\u304d\u307e\u3059\u306e\u3067\u3001\u753b\u9762\u306b\u5165\u529b\u3057\u3066\u304f\u3060\u3055\u3044\u3002</li> <li>\u30ed\u30b0\u30a4\u30f3: \u767b\u9332\u304c\u5b8c\u4e86\u3057\u305f\u3089\u3001\u30e1\u30fc\u30eb\u30a2\u30c9\u30ec\u30b9\u3068\u30d1\u30b9\u30ef\u30fc\u30c9\u3067\u30ed\u30b0\u30a4\u30f3\u3057\u307e\u3059\u3002</li> </ol>"},{"location":"getting-started/#2","title":"2. \u30c0\u30c3\u30b7\u30e5\u30dc\u30fc\u30c9\u306e\u898b\u65b9","text":"<p>\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u3068\u3001\u30c0\u30c3\u30b7\u30e5\u30dc\u30fc\u30c9\u304c\u8868\u793a\u3055\u308c\u307e\u3059\u3002</p> <ul> <li>\u30db\u30fc\u30e0: \u65b0\u3057\u3044\u8a18\u4e8b\u3092\u4f5c\u6210\u3059\u308b\u305f\u3081\u306e\u30e1\u30cb\u30e5\u30fc\u304c\u3042\u308a\u307e\u3059\u3002</li> <li>\u5c65\u6b74: \u904e\u53bb\u306b\u4f5c\u6210\u3057\u305f\u8a18\u4e8b\u306e\u4e00\u89a7\u3092\u78ba\u8a8d\u30fb\u4fee\u6b63\u3067\u304d\u307e\u3059\u3002</li> <li>\u30dd\u30a4\u30f3\u30c8\u6b8b\u9ad8: \u4eca\u6708\u4f7f\u3048\u308b\u8a18\u4e8b\u4f5c\u6210\u30dd\u30a4\u30f3\u30c8\u304c\u8868\u793a\u3055\u308c\u307e\u3059\u3002</li> </ul>"},{"location":"getting-started/#3","title":"3. \u300c\u30dd\u30a4\u30f3\u30c8\u300d\u306b\u3064\u3044\u3066","text":"<p>Hotel Post AI \u3067\u306f\u3001\u8a18\u4e8b\u3092\u4f5c\u6210\u3059\u308b\u305f\u3073\u306b\u300c\u30dd\u30a4\u30f3\u30c8\u300d\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002</p> <ul> <li>\u6bce\u6708\u4ed8\u4e0e: \u6bce\u67081\u65e5\u306b\u3001\u7121\u6599\u30dd\u30a4\u30f3\u30c8\u304c\u4ed8\u4e0e\u3055\u308c\u307e\u3059\u3002</li> <li>\u6d88\u8cbb\u91cf: \u8a18\u4e8b\u306e\u9577\u3055\u3084\u751f\u6210\u3059\u308b\u30e2\u30c7\u30eb\u306b\u3088\u3063\u3066\u6d88\u8cbb\u30dd\u30a4\u30f3\u30c8\u304c\u7570\u306a\u308a\u307e\u3059\uff08\u4f8b\uff1a\u30d6\u30ed\u30b0\u8a18\u4e8b 1\u56de 5pt\uff09\u3002</li> <li>\u78ba\u8a8d\u65b9\u6cd5: \u753b\u9762\u53f3\u4e0a\u306e\u30a2\u30a4\u30b3\u30f3\u304b\u3089\u3001\u73fe\u5728\u306e\u6b8b\u308a\u30dd\u30a4\u30f3\u30c8\u3092\u3044\u3064\u3067\u3082\u78ba\u8a8d\u3067\u304d\u307e\u3059\u3002</li> </ul> <p>\u6b21\u306f\u3001\u30db\u30c6\u30eb\u60c5\u5831\u306e\u767b\u9332\u3092\u884c\u3044\u307e\u3057\u3087\u3046\u3002</p>"},{"location":"hotel-registration/","title":"\u30db\u30c6\u30eb\u60c5\u5831\u306e\u767b\u9332","text":"<p>Hotel Post AI \u3092\u6700\u5927\u9650\u306b\u6d3b\u7528\u3059\u308b\u305f\u3081\u306b\u306f\u3001\u307e\u305a\u3042\u306a\u305f\u306e\u30db\u30c6\u30eb\u60c5\u5831\u3092\u6b63\u3057\u304f\u767b\u9332\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u3067\u3059\u3002 \u3053\u3053\u3067\u767b\u9332\u3057\u305f\u60c5\u5831\u3092\u3082\u3068\u306b\u3001AI\u304c\u3042\u306a\u305f\u306e\u30db\u30c6\u30eb\u3089\u3057\u3055\u3092\u53cd\u6620\u3057\u305f\u8a18\u4e8b\u3092\u4f5c\u6210\u3057\u307e\u3059\u3002</p>"},{"location":"hotel-registration/#_2","title":"\u767b\u9332\u624b\u9806","text":"<ol> <li> <p>\u30e1\u30cb\u30e5\u30fc\u304b\u3089\u300c\u30db\u30c6\u30eb\u767b\u9332\u300d\u3092\u9078\u629e    \u30c0\u30c3\u30b7\u30e5\u30dc\u30fc\u30c9\u306e\u30e1\u30cb\u30e5\u30fc\u306b\u3042\u308b\u300c\u30db\u30c6\u30eb\u767b\u9332\u300d\u3092\u30af\u30ea\u30c3\u30af\u3057\u307e\u3059\u3002</p> </li> <li> <p>\u57fa\u672c\u60c5\u5831\u306e\u5165\u529b    \u4ee5\u4e0b\u306e\u60c5\u5831\u3092\u5165\u529b\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p> </li> <li>\u30db\u30c6\u30eb\u540d: \u6b63\u5f0f\u540d\u79f0\u3092\u5165\u529b\u3057\u3066\u304f\u3060\u3055\u3044\uff08\u4f8b\uff1a\u30db\u30c6\u30eb\u30fb\u30dd\u30b9\u30c8\u30fb\u30a4\u30f3\u6771\u4eac\uff09\u3002</li> </ol> <p>\u203b \u73fe\u5728\u3001\u767b\u9332\u6a5f\u80fd\u306f\u30b7\u30f3\u30d7\u30eb\u3067\u3059\u304c\u3001\u5185\u90e8\u7684\u306b\u306f\u767b\u9332\u3055\u308c\u305f\u30db\u30c6\u30ebID\u306b\u7d10\u3065\u304f\u8a73\u7d30\u60c5\u5831\uff08\u7279\u5fb4\u3001\u30bf\u30fc\u30b2\u30c3\u30c8\u5c64\u306a\u3069\uff09\u3092\u7ba1\u7406\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u3063\u3066\u3044\u307e\u3059\u3002</p> <ol> <li>\u767b\u9332\u30dc\u30bf\u30f3\u3092\u30af\u30ea\u30c3\u30af    \u5165\u529b\u5185\u5bb9\u3092\u78ba\u8a8d\u3057\u3001\u300c\u767b\u9332\u300d\u30dc\u30bf\u30f3\u3092\u62bc\u3057\u307e\u3059\u3002</li> </ol> <p>[!TIP] \u30dd\u30a4\u30f3\u30c8: \u30db\u30c6\u30eb\u60c5\u5831\u306f\u4e00\u5ea6\u767b\u9332\u3059\u308c\u3070\u3001\u6bce\u56de\u5165\u529b\u3059\u308b\u5fc5\u8981\u306f\u3042\u308a\u307e\u305b\u3093\u3002AI\u304c\u5e38\u306b\u3053\u306e\u60c5\u5831\u3092\u53c2\u7167\u3057\u3066\u8a18\u4e8b\u3092\u66f8\u304d\u307e\u3059\u3002</p>"},{"location":"hotel-registration/#_3","title":"\u6b21\u306e\u30b9\u30c6\u30c3\u30d7","text":"<p>\u30db\u30c6\u30eb\u60c5\u5831\u306e\u767b\u9332\u304c\u3067\u304d\u305f\u3089\u3001\u3044\u3088\u3044\u3088\u8a18\u4e8b\u306e\u4f5c\u6210\u306b\u9032\u307f\u307e\u3057\u3087\u3046\uff01</p>"},{"location":"overview/","title":"Hotel Post AI \u3068\u306f\uff1f","text":"<p>\u300c\u8a18\u4e8b\u4f5c\u6210\u306b\u304b\u304b\u308b\u6642\u9593\u3092\u3001\u3082\u3063\u3068\u304a\u5ba2\u69d8\u306e\u305f\u3081\u306e\u6642\u9593\u3078\u3002\u300d</p> <p>Hotel Post AI \u306f\u3001\u30db\u30c6\u30eb\u306e\u9b45\u529b\u3092\u4f1d\u3048\u308b\u30d6\u30ed\u30b0\u3084SNS\uff08Instagram, X\u306a\u3069\uff09\u306e\u6295\u7a3f\u6587\u3092\u3001AI\u304c\u81ea\u52d5\u3067\u4f5c\u6210\u3057\u3066\u304f\u308c\u308b\u30b5\u30fc\u30d3\u30b9\u3067\u3059\u3002</p>"},{"location":"overview/#_1","title":"\u2728 \u3053\u3093\u306a\u3053\u3068\u304c\u3067\u304d\u307e\u3059","text":"<ul> <li>\u30d6\u30ed\u30b0\u8a18\u4e8b\u306e\u81ea\u52d5\u4f5c\u6210:   \u5b63\u7bc0\u306e\u30a4\u30d9\u30f3\u30c8\u3084\u30db\u30c6\u30eb\u306e\u7279\u5225\u306a\u30d7\u30e9\u30f3\u306b\u5408\u308f\u305b\u305f\u30d6\u30ed\u30b0\u8a18\u4e8b\u3092\u3001\u6570\u30af\u30ea\u30c3\u30af\u3067\u4f5c\u6210\u3067\u304d\u307e\u3059\u3002</li> <li>SNS\u6295\u7a3f\u6587\u306e\u4f5c\u6210:   Instagram\u3084X\uff08\u65e7Twitter\uff09\u306a\u3069\u3001\u5404SNS\u306b\u6700\u9069\u306a\u9577\u3055\u3084\u30c8\u30fc\u30f3\u3067\u6587\u7ae0\u3092\u4f5c\u6210\u3057\u307e\u3059\u3002</li> <li>\u591a\u8a00\u8a9e\u5bfe\u5fdc\u306e\u30b5\u30dd\u30fc\u30c8 (\u203b\u5c06\u6765\u7684\u306a\u6a5f\u80fd):   \u6d77\u5916\u306e\u304a\u5ba2\u69d8\u5411\u3051\u306b\u3001\u82f1\u8a9e\u3084\u4e2d\u56fd\u8a9e\u3067\u306e\u767a\u4fe1\u3082\u304a\u624b\u4f1d\u3044\u3057\u307e\u3059\u3002</li> </ul>"},{"location":"overview/#_2","title":"\ud83d\ude80 \u5c0e\u5165\u306e\u30e1\u30ea\u30c3\u30c8","text":"<ol> <li>\u6642\u9593\u77ed\u7e2e: \u3053\u308c\u307e\u30671\u6642\u9593\u304b\u304b\u3063\u3066\u3044\u305f\u8a18\u4e8b\u4f5c\u6210\u304c\u3001\u6570\u5206\u3067\u5b8c\u4e86\u3057\u307e\u3059\u3002</li> <li>\u30af\u30aa\u30ea\u30c6\u30a3\u306e\u5b89\u5b9a: \u6587\u7ae0\u304c\u82e6\u624b\u306a\u30b9\u30bf\u30c3\u30d5\u3067\u3082\u3001\u30d7\u30ed\u306e\u3088\u3046\u306a\u9b45\u529b\u7684\u306a\u6587\u7ae0\u3092\u4f5c\u6210\u3067\u304d\u307e\u3059\u3002</li> <li>\u767a\u4fe1\u983b\u5ea6\u306e\u5411\u4e0a: \u624b\u8efd\u306b\u4f5c\u308c\u308b\u304b\u3089\u3001\u6bce\u65e5\u306e\u767a\u4fe1\u3082\u82e6\u306b\u306a\u308a\u307e\u305b\u3093\u3002</li> </ol>"},{"location":"overview/#_3","title":"\ud83d\udd04 \u3054\u5229\u7528\u306e\u6d41\u308c","text":"<p>\u57fa\u672c\u7684\u306a\u4f7f\u3044\u65b9\u306f\u3068\u3066\u3082\u30b7\u30f3\u30d7\u30eb\u3067\u3059\u3002</p> <ol> <li>\u30db\u30c6\u30eb\u60c5\u5831\u3092\u767b\u9332\u3059\u308b: \u6700\u521d\u306b\u4e00\u5ea6\u3060\u3051\u3001\u3042\u306a\u305f\u306e\u30db\u30c6\u30eb\u306e\u7279\u5fb4\u3092\u767b\u9332\u3057\u307e\u3059\u3002</li> <li>\u30c6\u30fc\u30de\u3092\u9078\u3076: \u300c\u6625\u306e\u30e9\u30f3\u30c1\u30d5\u30a7\u30a2\u300d\u300c\u30af\u30ea\u30b9\u30de\u30b9\u30c7\u30a3\u30ca\u30fc\u300d\u306a\u3069\u3001\u66f8\u304d\u305f\u3044\u30c6\u30fc\u30de\u3092\u5165\u529b\u3057\u307e\u3059\u3002</li> <li>AI\u304c\u4f5c\u6210: \u30dc\u30bf\u30f3\u3092\u62bc\u3059\u3068\u3001AI\u304c\u6570\u79d2\u3067\u8a18\u4e8b\u3092\u66f8\u304d\u4e0a\u3052\u307e\u3059\u3002</li> <li>\u78ba\u8a8d\u30fb\u6295\u7a3f: \u5185\u5bb9\u3092\u